			<!--
			  Documentation coverage (Coverxygen LCOV + HTML) for site menu "Coverxygen Report".
			  Requires: Doxygen on PATH, Python + coverxygen (pip), dotnet ReportGenerator (genhtml optional).
			  CI builds doc coverage before mvn site and passes -Ddoc.coverage.skip=true to avoid duplicating work.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>doc-coverage-and-site-assets</id>
						<phase>pre-site</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<skip>${doc.coverage.skip}</skip>
							<target>
								<mkdir dir="${project.reporting.outputDirectory}/coverxygen" />
								<exec executable="doxygen" dir="${repo.root.dir}" failonerror="true">
									<arg value="Doxyfile" />
								</exec>
								<exec executable="${python.executable}" failonerror="true">
									<arg value="-m" />
									<arg value="pip" />
									<arg value="install" />
									<arg value="-q" />
									<arg value="coverxygen" />
								</exec>
								<exec executable="${python.executable}" failonerror="true">
									<arg value="-m" />
									<arg value="coverxygen" />
									<arg value="--xml-dir" />
									<arg value="${project.reporting.outputDirectory}/doxygen/xml" />
									<arg value="--src-dir" />
									<arg value="${repo.root.dir}" />
									<arg value="--format" />
									<arg value="lcov" />
									<arg value="--output" />
									<arg value="${project.reporting.outputDirectory}/coverxygen/lcov.info" />
									<arg value="--prefix" />
									<arg value="${project.basedir}/" />
								</exec>
								<exec executable="reportgenerator" failonerror="true">
									<arg value="-reports:${project.reporting.outputDirectory}/coverxygen/lcov.info" />
									<arg value="-targetdir:${project.reporting.outputDirectory}/coverxygen" />
									<arg value="-reporttypes:Html" />
									<arg value="-title:Documentation Coverage Report" />
								</exec>
							</target>
						</configuration>
					</execution>
					<execution>
						<id>copy-doxygen-pdf-to-site</id>
						<phase>pre-site</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<copy file="${project.basedir}/../docs/doxygen/refman.pdf"
									tofile="${project.reporting.outputDirectory}/refman-api.pdf"
									failonerror="false" quiet="true" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Maven Shade Plugin -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.2.4</version>
				<executions>
